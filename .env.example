# Copy to .env and fill in with your own backend (Supabase) project values.
# Client-visible (safe to expose, they are publishable keys)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side (used during SSR / server functions)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# SECRET — never commit, never expose to the browser.
# Only needed if you add admin/service-role server code.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
